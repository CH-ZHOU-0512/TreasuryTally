# Offline app-only release: dependencies must match the verified runtime image.
ARG RUNTIME_IMAGE=trust-receipt:m8-821bbc2
FROM ${RUNTIME_IMAGE}
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION
USER root
COPY trust_receipt-0.1.0-py3-none-any.whl /tmp/trust_receipt-0.1.0-py3-none-any.whl
RUN python -m pip install --no-index --no-deps --force-reinstall /tmp/trust_receipt-0.1.0-py3-none-any.whl && python -m pip check
# The real entrypoint prepends /app/src. Updating only the wheel is insufficient.
COPY --chown=app:app src /app/src
COPY --chown=app:app app /app/app
COPY --chown=app:app fixtures /app/fixtures
COPY --chown=app:app .streamlit /app/.streamlit
COPY scripts/deploy/check_image.py /opt/trust-receipt-smoke/check_image.py
WORKDIR /app
USER app
# -c retains the /app working-directory import semantics of python -m streamlit.
RUN python -c "import runpy; runpy.run_path('/opt/trust-receipt-smoke/check_image.py', run_name='__main__')"
