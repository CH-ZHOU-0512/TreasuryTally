FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /tmp/blockscout-mcp
RUN python -m pip install --no-cache-dir blockscout-mcp-server==0.19.0

EXPOSE 8000
CMD ["python", "-m", "blockscout_mcp_server", "--http", \
     "--http-host", "0.0.0.0", "--http-port", "8000"]

